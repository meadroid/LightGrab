<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 标题行：左标题 + 右齿轮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/title_text"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/titleGray" />

        <TextView
            android:id="@+id/btnArsenal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="⚙️"
            android:textSize="16sp"
            android:contentDescription="@string/arsenal" />
    </LinearLayout>

    <!-- 模式胶囊行：4个胶囊，间距均匀 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView style="@style/Chip" android:id="@+id/chipShadow" android:text="🕵️ 影子" />
        <TextView style="@style/Chip" android:id="@+id/chipSentry" android:text="🪖 哨兵" />
        <TextView style="@style/Chip" android:id="@+id/chipSniper" android:text="🎯 狙击" />
        <TextView style="@style/Chip" android:id="@+id/chipSilent" android:text="🌙 静默"
            android:layout_marginEnd="0dp" />
    </LinearLayout>

    <!-- 监听按钮：和胶囊同高32dp、同字号13sp，视觉统一 -->
    <Button
        android:id="@+id/btnMain"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:minHeight="0dp"
        android:layout_marginTop="14dp"
        android:backgroundTint="@color/mint"
        android:textColor="@color/mintTextOn"
        android:textSize="16sp"
        android:text="开启监听" />

    <!-- 状态三行 -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:lineSpacingExtra="6dp"
        android:textSize="15sp"
        android:textColor="@color/grayText"
        android:fontFamily="monospace"
        android:text="♟️ 模式：待启动" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp">

        <ScrollView
            android:id="@+id/logScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/mintBg">

            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:paddingEnd="10dp"
                android:textSize="12sp"
                android:textColor="@color/grayText"
                android:fontFamily="monospace"
                android:text="" />
        </ScrollView>

        <TextView
            android:id="@+id/btnCopyLog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:padding="6dp"
            android:text="📋"
            android:textSize="12sp"
            android:textColor="@color/grayText"
            android:contentDescription="@string/btn_copy_log" />

    </FrameLayout>

</LinearLayout>
